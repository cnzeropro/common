# EditorConfig: https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{java,py,sql,gradle}]
indent_size = 4

[*.{js,yml,toml,xml,properties,config}]
indent_size = 2

[*.sh]
indent_size = 2
end_of_line = lf

[*.ps1]
indent_size = 4
end_of_line = lf

[*.{cmd,bat}]
end_of_line = crlf
indent_size = 4

[*.md]
trim_trailing_whitespace = false
