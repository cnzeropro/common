# 文本文件自动识别并统一以 LF 存入仓库
* text=auto eol=lf

# Java 源码启用 Git 内置 diff 驱动
*.java text diff=java

# 脚本 / wrapper / 钩子固定 LF
*.sh text eol=lf
*.ps1 text eol=lf
mvnw text eol=lf
gradlew text eol=lf

# Windows 批处理必须 CRLF（cmd.exe 兼容）
*.cmd text eol=crlf
*.bat text eol=crlf

# 二进制文件不参与文本归一化与 diff
*.jar binary
*.xdb binary
